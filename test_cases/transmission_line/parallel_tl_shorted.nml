&RunTitle
   title = 'Shorted parallel-wire TL, s=3mm, a=1mm, l=0.15lambda, lambda=1m'
/

&Frequency_MHz
   fmin  = 299.792458
   fmax  = 299.792458
   nFreq = 1
/

&Ground
   Ground_Plane = 'free_space'
   epsilon = 1.0
   sigma = 0.0
/

&OPTIONS
   NBASISPERLAMBDA = 40
   Output_Currents = .TRUE.
/

&node_input
   zHeight = 0.0
   nNodes = 5
   units = 'meters'

 node_list(1) = 'A', 0.0,  0.0,   0.0
 node_list(2) = 'B', 0.15, 0.0,   0.0
 node_list(3) = 'C', 0.0,  0.003, 0.0
 node_list(4) = 'D', 0.15, 0.003, 0.0
 node_list(5) = 'M', 0.0,  0.0015, 0.0
/

&wire_primitive
   tag   = 'W1',
   nNodes = 2,
   nodeTags = 'A' 'B'
   radius     = 0.001
/

&wire_primitive
   tag   = 'W2',
   nNodes = 2,
   nodeTags = 'C' 'D'
   radius     = 0.001
/

&wire_primitive
   tag   = 'W3',
   nNodes = 3,
   nodeTags = 'A' 'M' 'C'
   radius     = 0.001
/

&wire_primitive
   tag   = 'W4',
   nNodes = 2,
   nodeTags = 'B' 'D'
   radius     = 0.001
/

&excitation_input
   wireTag = 'W3'
   nodeTag = 'M'
   voltage = 1.0
   phase_deg = 0.0
/

