&RunTitle
   title = 'Renee 80 m loop'
/

&Frequency_MHz
   fmin  = 5.0
   fmax  = 30.0
   fstep = 0.05
   nFreq = 0
/

&Ground
   Ground_Plane = 'real'
   epsilon = 14.0
   sigma = 0.005
/

&OPTIONS
   NBASISPERLAMBDA = 40
   Output_Currents = .FALSE.
   sweep_mode = 'vna_sweep'
/

&node_input
   zHeight = 0.0
   nNodes = 3
   units = 'feet'

 node_list(1) = 'A', 0.0, 0.0, 70.0
 node_list(2) = 'B', 90.2, 0.0, 70.0
 node_list(3) = 'C', 49.0, 79.0, 60.0
/

&wire_primitive
   tag   = 'W1',
   nNodes = 2,
   nodeTags = 'A' 'B'
   radius     = 0.001
/

&wire_primitive
   tag   = 'W2',
   nNodes = 2,
   nodeTags = 'B' 'C'
   radius     = 0.001
/

&wire_primitive
   tag   = 'W3',
   nNodes = 2,
   nodeTags = 'C' 'A'
   radius     = 0.001
/

&excitation_input
   wireTag = 'W1'
   nodeTag = 'A'
   voltage = 1.0
   phase_deg = 0.0
/

