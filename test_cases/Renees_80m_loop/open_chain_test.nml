&RunTitle
   title = 'open chain test - 2 junctions no closure'
/

&Frequency_MHz
   fmin  = 3.8
   fmax  = 3.8
   nFreq = 1
/

&Ground
   Ground_Plane = 'free_space'
   epsilon = 14.0
   sigma = 0.005
/

&OPTIONS
   NBASISPERLAMBDA = 40
   Output_Currents = .TRUE.
/

&node_input
   zHeight = 0.0
   nNodes = 4
   units = 'meters'

 node_list(1) = 'A', 0.0, 13.74648, 21.336
 node_list(2) = 'B', 0.0, -13.74648, 21.336
 node_list(3) = 'C', -23.7744, -1.524, 18.288
 node_list(4) = 'D', -14.15054211, -8.07285348, 44.21470122
/

&wire_primitive
   tag   = 'W1',
   nNodes = 2,
   nodeTags = 'A' 'B'
   radius     = 0.001
/

&wire_primitive
   tag   = 'W2',
   nNodes = 2,
   nodeTags = 'B' 'C'
   radius     = 0.001
/

&wire_primitive
   tag   = 'W3',
   nNodes = 2,
   nodeTags = 'C' 'D'
   radius     = 0.001
/

&excitation_input
   wireTag = 'W1'
   nodeTag = 'A'
   voltage = 1.0
   phase_deg = 0.0
/

