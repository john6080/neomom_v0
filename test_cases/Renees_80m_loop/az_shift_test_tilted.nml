&RunTitle
   title = 'short dipole test - tilted'
/

&Frequency_MHz
   fmin  = 1.5
   fmax  = 1.5
   nFreq = 1
/

&Ground
   Ground_Plane = 'free_space'
   epsilon = 14.0
   sigma = 0.005
/

&OPTIONS
   NBASISPERLAMBDA = 40
   Output_Currents = .TRUE.
/

&node_input
   zHeight = 0.0
   nNodes = 2
   units = 'meters'

 node_list(1) = 'A', 0.0, 0.0, 0.0
 node_list(2) = 'B', 10.0, 5.0, 4.0
/

&wire_primitive
   tag   = 'W1',
   nNodes = 2,
   nodeTags = 'A' 'B'
   radius     = 0.001
/

&excitation_input
   wireTag = 'W1'
   nodeTag = 'A'
   voltage = 1.0
   phase_deg = 0.0
/

