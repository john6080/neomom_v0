&RunTitle
   title = 'J Pole: DBJ-1 (original)'
/

&Frequency_MHz
   fmin  = 140.0
   fmax  = 170.0
   fstep = 0.1
   nFreq = 0
/

&Ground
   Ground_Plane = 'free_space'
   epsilon = 14.0
   sigma = 0.005
/

&OPTIONS
   NBASISPERLAMBDA = 40
   Output_Currents = .FALSE.
   sweep_mode = 'vna_sweep'
/

&node_input
   zHeight = 0.0
   nNodes = 9
   units = 'inches'

 node_list(1) = 'LB', 0.0, -0.25, -18.5
 node_list(2) = 'LF', 0.0, -0.25, -17.75
 node_list(3) = 'LGB', 0.0, -0.25, 0.0
 node_list(4) = 'LGTOP', 0.0, -0.25, 0.25
 node_list(5) = 'LTOP', 0.0, -0.25, 43.9
 node_list(6) = 'F', 0.0, 0.0, -17.75
 node_list(7) = 'RB', 0.0, 0.25, -18.5
 node_list(8) = 'RF', 0.0, 0.25, -17.75
 node_list(9) = 'RTOP', 0.0, 0.25, 43.9
/

&wire_primitive
   tag   = 'W1',
   nNodes = 6,
   nodeTags = 'LGB' 'LF' 'LB' 'RB' 'RF' 'RTOP'
   radius     = 0.0005
/

&wire_primitive
   tag   = 'W2',
   nNodes = 2,
   nodeTags = 'LGTOP' 'LTOP'
   radius     = 0.0005
/

&wire_primitive
   tag   = 'W3',
   nNodes = 3,
   nodeTags = 'LF' 'F' 'RF'
   radius     = 0.0005
/

&excitation_input
   wireTag = 'W3'
   nodeTag = 'F'
   voltage = 1.0
   phase_deg = 0.0
/

