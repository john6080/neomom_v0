&RunTitle
   title = 'EFHW, 40m, free space, 5-35 MHz'
/

&Frequency_MHz
   fmin  = 5.0
   fmax  = 35.0
   fstep = 0.005
   nFreq = 0
/

&Ground
   Ground_Plane = 'free_space'
   epsilon = 1.0
   sigma = 0.0
/

&OPTIONS
   NBASISPERLAMBDA = 40
   Output_Currents = .FALSE.
   sweep_mode = 'vna_sweep'
/

&node_input
   zHeight = 0.0
   nNodes = 3
   units = 'meters'

 node_list(1) = 'A', 0.0, 0.0, 0.0
 node_list(2) = 'B', -10.0, 0.0, 0.0
 node_list(3) = 'C', 10.0, 0.0, 0.0
/

&wire_primitive
   tag   = 'W1',
   nNodes = 3,
   nodeTags = 'B' 'A' 'C'
   radius     = 0.001
/

&excitation_input
   wireTag = 'W1'
   nodeTag = 'B'
   voltage = 1.0
   phase_deg = 0.0
/

