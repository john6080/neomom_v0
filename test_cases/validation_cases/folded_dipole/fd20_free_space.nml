&RunTitle
   title = 'folded dipole 20m'
/

&Frequency_MHz
   fmin  = 14.05
   fmax  = 14.05
   nFreq = 1
/

&Ground
   Ground_Plane = free_space
   epsilon = 1.0
   sigma = 0.0
/

&OPTIONS
   NBASISPERLAMBDA = 40
/

&node_input
   zHeight = 0.0
   nNodes = 5
   units = meters

 node_list(1) = N1, 0.0, -5.025, -0.1
 node_list(2) = N2, 0.0, 5.025, -0.1
 node_list(3) = N3, 0.0, 5.025, 0.1
 node_list(4) = N4, 0.0, -5.025, 0.1
 node_list(5) = A, 0.0, 0.0, -0.1
/

&wire_primitive
   tag   = W1,
   nNodes = 3,
   nodeTags = N1 A N2
   radius     = 0.0015
/

&wire_primitive
   tag   = W2,
   nNodes = 2,
   nodeTags = N2 N3
   radius     = 0.0015
/

&wire_primitive
   tag   = W3,
   nNodes = 2,
   nodeTags = N3 N4
   radius     = 0.0015
/

&wire_primitive
   tag   = W4,
   nNodes = 2,
   nodeTags = N4 N1
   radius     = 0.0015
/

&excitation_input
   wireTag = W1
   nodeTag = A
   voltage = 1.0
   phase_deg = 0.0
/

