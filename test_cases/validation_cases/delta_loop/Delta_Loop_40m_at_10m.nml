&RunTitle
   title = '40 m Delta Loop at 10 m'
/

&Frequency_MHz
   fmin  = 29.0
   fmax  = 29.0
   nFreq = 1
/

&GROUND
   Ground_Plane = real
   epsilon = 14.0
   sigma = 0.005
/

&OPTIONS
   NBASISPERLAMBDA = 40
/

&node_input
   zHeight = 13.0
   nNodes = 3
   units = meters

 node_list(1) = A, -10.0, 0.0, 0.0
 node_list(2) = B, 10.0, 0.0, 0.0
 node_list(3) = C, 0.0, -20.0, 0.0
/

&wire_primitive
   tag   = W1,
   nNodes = 4,
   nodeTags = C B A C
   radius     = 0.001
/

&excitation_input
   wireTag = W1
   nodeTag = C
   voltage = 1.0
   phase_deg = 0.0
/

