&RunTitle
   title = 'Sec V, Table 2 45 deg'
/

&Frequency_MHz
   fmin  = 299.792
   fmax  = 299.792
   nFreq = 1
/

&Ground
   Ground_Plane = 'free_space'
   epsilon = 1.0
   sigma = 0.0
/

&OPTIONS
   NBASISPERLAMBDA = 40
   Output_Currents = .FALSE.
/

&node_input
   zHeight = 0.0
   nNodes = 3
   units = 'meters'

 node_list(1) = 'A', 0.0, 0.0, -0.235
 node_list(2) = 'B', 0.0, 0.0, 0.0
 node_list(3) = 'C', 0.0, 0.16615, 0.16615
/

&wire_primitive
   tag   = 'W1',
   nNodes = 3,
   nodeTags = 'A' 'B' 'C'
   radius     = 0.001
/

&excitation_input
   wireTag = 'W1'
   nodeTag = 'B'
   voltage = 1.0
   phase_deg = 0.0
/

