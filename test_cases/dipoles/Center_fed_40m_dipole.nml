&RunTitle
   title = '40 m center fed dipole'
/

&Frequency_MHz
   fmin  = 7.25
   fmax  = 7.25
   nFreq = 1
/

&Ground
   Ground_Plane = 'free_space'
   epsilon = 14.0
   sigma = 0.005
/

&OPTIONS
   NBASISPERLAMBDA = 40
   Output_Currents = .FALSE.
/

&node_input
   zHeight = 30.0
   nNodes = 3
   units = 'feet'

 node_list(1) = 'A', -33.0, 0.0, 0.0
 node_list(2) = 'B', 0.0, 0.0, 0.0
 node_list(3) = 'C', 33.0, 0.0, 0.0
/

&wire_primitive
   tag   = 'W1',
   nNodes = 3,
   nodeTags = 'A' 'B' 'C'
   radius     = 0.001
/

&excitation_input
   wireTag = 'W1'
   nodeTag = 'B'
   voltage = 1.0
   phase_deg = 0.0
/

