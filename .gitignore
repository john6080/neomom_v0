# ==============================================================
# .gitignore — NeoMOM
# ==============================================================

# ==============================================================
# FORTRAN BUILD ARTIFACTS
# ==============================================================

engine/build/
build/

*.o
*.mod
*.obj
*.pdb

engine/windows/x64/
engine/windows/Debug/
engine/windows/Release/
engine/windows/*.u2d
*.suo
*.user
.vs/

# ==============================================================
# PYTHON BUILD ARTIFACTS
# ==============================================================

neomom_input/build/
neomom_plot/build/
neomom_current/build/
neomom_Zin/build/

__pycache__/
*.pyc
*.pyo
*.pyd
*.spec.bak

# ==============================================================
# PACKAGES — generated by build scripts
# ==============================================================

packages/linux/
packages/windows/
packages/macos/
packages/*.zip

# ==============================================================
# ENGINE RUN OUTPUT — generated files, never committed
# ==============================================================

test_cases/**/*.csv
test_cases/**/*.cur
test_cases/**/*.txt
test_cases/**/*.nec.out
test_cases/**/*.nec.txt
test_cases/**/*_Zin.csv

# Stray test files in source directories
neomom_Zin/src/*.csv
neomom_input/src/*.csv
neomom_plot/src/*.csv

# ==============================================================
# OS AND EDITOR NOISE
# ==============================================================

.DS_Store
*~
*.swp
*.swo
Thumbs.db
desktop.ini

# VS Code — keep launch.json and tasks.json
.vscode/settings.json
.vscode/extensions.json

# ==============================================================
# KEEP EMPTY DIRECTORIES
# ==============================================================

# (see packages/.gitkeep)
