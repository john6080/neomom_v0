# ==============================================================
# .gitignore — NeoMOM
# ==============================================================

# ==============================================================
# FORTRAN BUILD ARTIFACTS
# ==============================================================

engine/build/
engine/bin/
build/

*.o
*.mod
*.obj
*.pdb

engine/windows/x64/
engine/windows/Debug/
engine/windows/Release/
engine/windows/*.u2d
*.suo
*.user
.vs/

# ==============================================================
# PYTHON BUILD ARTIFACTS
# ==============================================================

neomom_input/build/
neomom_plot/build/
neomom_current/build/
neomom_Zin/build/

__pycache__/
*.pyc
*.pyo
*.pyd
*.spec.bak

# ==============================================================
# PACKAGES — everything here is generated by the build scripts
# (platform dirs, zips, extracted copies). Keep only the tracked
# README and the .gitkeep placeholder.
# ==============================================================

packages/*
!packages/.gitkeep
!packages/README.txt

# ==============================================================
# ARCHIVES — zips are build artifacts, not source. Regenerate from
# the source files instead of committing. (Any .zip that is a
# deliberately-tracked data bundle stays tracked — .gitignore does
# not untrack files git already tracks.)
# ==============================================================

*.zip

# ==============================================================
# ENGINE RUN OUTPUT — generated files, never committed
# ==============================================================

test_cases/**/*.csv
test_cases/**/*.cur
test_cases/**/*.txt
test_cases/**/*.nec.out
test_cases/**/*.nec.txt
test_cases/**/*_Zin.csv

# Stray test files in source directories
neomom_Zin/src/*.csv
neomom_input/src/*.csv
neomom_plot/src/*.csv

# examples/ ships .nml inputs; ignore run output produced when they are run
examples/*.csv
examples/*.cur
examples/*.txt
examples/*.nec.out
examples/*.nec.txt

# Scratch / ad-hoc engine runs at the repo root (junk.nml and its outputs)
/junk.*

# ==============================================================
# OS AND EDITOR NOISE
# ==============================================================

.DS_Store
*~
*.swp
*.swo
Thumbs.db
desktop.ini

# VS Code — keep launch.json and tasks.json
.vscode/settings.json
.vscode/extensions.json

# ==============================================================
# KEEP EMPTY DIRECTORIES
# ==============================================================

# (see packages/.gitkeep)
