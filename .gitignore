# ==============================================================
# .gitignore — NeoMOM / AntennaModeling_neoMoM
# ==============================================================

# ==============================================================
# FORTRAN BUILD ARTIFACTS
# ==============================================================

# Local engine build (Linux make)
engine/build/

# Top-level installed binary (Linux)
build/

# Fortran compiled artifacts
*.o
*.mod
*.obj         # Windows VS object files
*.pdb         # Windows debug symbols

# Visual Studio build output
engine/windows/x64/
engine/windows/Debug/
engine/windows/Release/

# VS IDE files — machine-specific, not source
engine/windows/*.u2d
*.suo
*.user
.vs/

# ==============================================================
# PYTHON BUILD ARTIFACTS
# ==============================================================

# PyInstaller local builds
input_gui/build/
plot_gui/build/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# PyInstaller spec backups
*.spec.bak

# ==============================================================
# PACKAGES — generated by build scripts, not stored in repo
# ==============================================================

packages/linux/
packages/windows/
packages/macos/
packages/*.zip

# ==============================================================
# OS AND EDITOR NOISE
# ==============================================================

# Linux
.DS_Store
*~
*.swp
*.swo

# Windows
Thumbs.db
desktop.ini

# VS Code

# VS Code — keep launch and tasks, ignore machine-specific settings
.vscode/settings.json
.vscode/extensions.json
# launch.json and tasks.json are intentionally NOT ignored
#==============================


# ==============================================================
# KEEP EMPTY DIRECTORIES
# Git does not track empty dirs — these placeholders ensure
# the directory structure is preserved on fresh clone.
# ==============================================================

# (see packages/.gitkeep, engine/windows/macos stubs if added)
neomom_Zin/build/
